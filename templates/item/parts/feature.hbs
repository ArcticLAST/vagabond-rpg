<div class="form-row">
  <div class="form-group"><label>{{localize "VAGABOND.FeatureSource.Label"}}</label><select name="system.featureSource">{{selectOptions options.featureSources selected=source.featureSource localize=true}}</select></div>
  <div class="form-group"><label>{{localize "VAGABOND.Feature.Origin"}}</label><input type="text" name="system.origin" value="{{source.origin}}"></div>
  <div class="form-group"><label>{{localize "VAGABOND.Level"}}</label><input type="number" name="system.level" value="{{source.level}}" min="0"></div>
</div>
