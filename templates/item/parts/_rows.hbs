<div class="feature-rows">
  {{#each rows}}
  <div class="feature-row">
    <div class="form-row">
      {{#if ../withLevel}}<div class="form-group small"><label>{{localize "VAGABOND.Level"}}</label><input type="number" name="system.{{../list}}.{{index}}.level" value="{{level}}" min="0"></div>{{/if}}
      <div class="form-group grow"><label>{{localize "Name"}}</label><input type="text" name="system.{{../list}}.{{index}}.name" value="{{name}}"></div>
      {{#if @root.editable}}<a class="item-control" data-action="deleteRow" data-list="{{../list}}" data-index="{{index}}" data-tooltip="VAGABOND.Sheet.Delete"><i class="fa-solid fa-trash"></i></a>{{/if}}
    </div>
    <details class="grants">
      <summary>{{localize "VAGABOND.Grants.Label"}}</summary>
      <div class="form-row">
        <div class="form-group grow"><label>{{localize "VAGABOND.Grants.Perks"}}</label><input type="text" name="system.{{../list}}.{{index}}.grants.perks" value="{{grants.perks}}"></div>
        <div class="form-group small"><label>{{localize "VAGABOND.Grants.PerkChoices"}}</label><input type="number" name="system.{{../list}}.{{index}}.grants.perkChoices" value="{{grants.perkChoices}}" min="0"></div>
        <div class="form-group small"><label>{{localize "VAGABOND.Grants.TrainingChoices"}}</label><input type="number" name="system.{{../list}}.{{index}}.grants.trainingChoices" value="{{grants.trainingChoices}}" min="0"></div>
      </div>
      <div class="form-row">
        <div class="form-group grow"><label>{{localize "VAGABOND.Grants.Spells"}}</label><input type="text" name="system.{{../list}}.{{index}}.grants.spells" value="{{grants.spells}}"></div>
        <div class="form-group small"><label>{{localize "VAGABOND.Grants.SpellChoices"}}</label><input type="number" name="system.{{../list}}.{{index}}.grants.spellChoices" value="{{grants.spellChoices}}" min="0"></div>
        <div class="form-group small"><label>{{localize "VAGABOND.Grants.StatIncrease"}}</label><input type="number" name="system.{{../list}}.{{index}}.grants.statIncrease" value="{{grants.statIncrease}}" min="0"></div>
        <div class="form-group small"><label>{{localize "VAGABOND.Grants.Levels"}}</label><input type="text" name="system.{{../list}}.{{index}}.grants.levels" value="{{grants.levels}}" placeholder="1, 4, 8"></div>
      </div>
    </details>
    <prose-mirror name="system.{{../list}}.{{index}}.description" value="{{description}}" document-uuid="{{@root.item.uuid}}" toggled>{{{html}}}</prose-mirror>
  </div>
  {{/each}}
  {{#if @root.editable}}<button type="button" data-action="addRow" data-list="{{list}}"><i class="fa-solid fa-plus"></i> {{localize "VAGABOND.Sheet.AddFeature"}}</button>{{/if}}
</div>
