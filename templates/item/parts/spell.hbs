<div class="form-row">
  <div class="form-group"><label>{{localize "VAGABOND.Spell.DamageBase"}}</label><select name="system.damageBase">{{selectOptions options.damageBases selected=source.damageBase localize=true}}</select></div>
  <div class="form-group"><label>{{localize "VAGABOND.Damage.Die"}}</label><select name="system.damageDie">{{selectOptions options.dieFaces selected=source.damageDie}}</select></div>
  <div class="form-group"><label>{{localize "VAGABOND.Cast.DefaultDelivery"}}</label><select name="system.delivery">{{selectOptions options.deliveries selected=source.delivery localize=true}}</select></div>
</div>
<div class="form-row">
  <div class="form-group checkbox"><label>{{localize "VAGABOND.Spell.Focus"}}</label><input type="checkbox" name="system.focus" {{checked source.focus}}></div>
  <div class="form-group checkbox"><label>{{localize "VAGABOND.Spell.NoDamage"}}</label><input type="checkbox" name="system.noDamage" {{checked source.noDamage}}></div>
  {{#if source.castSkill}}<div class="form-group"><label data-tooltip="VAGABOND.Spell.CastSkillHint">{{localize "VAGABOND.Spell.CastSkill"}}</label><select name="system.castSkill">{{selectOptions options.castSkills selected=source.castSkill localize=true}}</select></div>{{/if}}
</div>
<div class="form-group stacked"><label>{{localize "VAGABOND.Spell.Crit"}}</label><textarea name="system.crit" rows="3">{{source.crit}}</textarea></div>
