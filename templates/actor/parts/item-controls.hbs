<div class="item-controls">
  {{#if (or (eq item.type "weapon") (eq item.type "armor") (eq item.type "gear"))}}
  <a class="item-control equip {{#if system.equipped}}active{{/if}}" data-action="toggleEquip" data-tooltip="{{#if system.equipped}}VAGABOND.Sheet.Unequip{{else}}VAGABOND.Sheet.Equip{{/if}}">
    <i class="fa-solid fa-shield-halved"></i></a>
  {{/if}}
  <a class="item-control" data-action="toggleDescription" data-tooltip="VAGABOND.Sheet.Details"><i class="fa-solid fa-circle-info"></i></a>
  {{#if @root.editable}}
  <a class="item-control" data-action="editItem" data-tooltip="VAGABOND.Sheet.Edit"><i class="fa-solid fa-pen-to-square"></i></a>
  <a class="item-control" data-action="deleteItem" data-tooltip="VAGABOND.Sheet.Delete"><i class="fa-solid fa-trash"></i></a>
  {{/if}}
</div>
