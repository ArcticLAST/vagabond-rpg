{
  "id": "vagabond-rpg",
  "title": "Vagabond (Alpha 3)",
  "description": "An unofficial Foundry VTT game system for Vagabond, the pulp fantasy roleplaying game by Land of the Blind. Built against the Core Rulebook v3 Alpha 3 playtest material.",
  "version": "0.6.7",
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "authors": [
    {
      "name": "Arctic"
    }
  ],
  "esmodules": [
    "vagabond.mjs"
  ],
  "styles": [
    "styles/vagabond.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "documentTypes": {
    "Actor": {
      "character": {
        "htmlFields": [
          "details.biography",
          "details.notes"
        ]
      },
      "npc": {
        "htmlFields": [
          "details.description"
        ]
      },
      "container": {
        "htmlFields": [
          "details.description"
        ]
      },
      "vehicle": {
        "htmlFields": [
          "details.description"
        ]
      }
    },
    "Item": {
      "weapon": {
        "htmlFields": [
          "description"
        ]
      },
      "armor": {
        "htmlFields": [
          "description"
        ]
      },
      "gear": {
        "htmlFields": [
          "description"
        ]
      },
      "spell": {
        "htmlFields": [
          "description"
        ]
      },
      "perk": {
        "htmlFields": [
          "description"
        ]
      },
      "feature": {
        "htmlFields": [
          "description"
        ]
      },
      "class": {
        "htmlFields": [
          "description"
        ]
      },
      "ancestry": {
        "htmlFields": [
          "description"
        ]
      },
      "action": {
        "htmlFields": [
          "description"
        ]
      }
    }
  },
  "packs": [
